{
  "name": "kbox",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:frontend": "esbuild src/frontend/shell.ts src/frontend/shared.ts src/frontend/registry.ts src/frontend/tools/*.ts --format=esm --target=es2022 --outdir=public/js --outbase=src/frontend --allow-overwrite --log-level=warning",
    "dev": "npm run build:frontend && wrangler dev",
    "deploy": "npm run build:frontend && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9",
    "wrangler": "^4.112.0"
  }
}
