{
  "name": "kbox",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "gen:registry": "node script/gen-registry.mjs",
    "typecheck:frontend": "tsc -p src/frontend/tsconfig.json --noEmit",
    "build:frontend": "npm run gen:registry && npm run typecheck:frontend && node script/build-frontend.mjs",
    "dev": "npm run build:frontend && wrangler dev",
    "deploy": "npm run build:frontend && wrangler deploy",
    "typecheck": "tsc --noEmit && npm run typecheck:frontend",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.1",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9",
    "wrangler": "^4.112.0"
  }
}
